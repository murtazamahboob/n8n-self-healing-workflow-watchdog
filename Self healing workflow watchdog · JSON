          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "c07d9118-7501-46ab-814e-17d19016a42b",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [-2384, 1184],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Extract Error Context').first().json;\nconst out = $input.first().json;\n\nlet raw = '';\ntry {\n  raw = out.text\n     || out.output\n     || out.message?.content\n     || out.choices?.[0]?.message?.content\n     || out.output_text\n     || out.content?.[0]?.text\n     || '';\n} catch (e) {\n  raw = '';\n}\n\nraw = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet diagnosis;\ntry {\n  diagnosis = JSON.parse(raw);\n} catch (e) {\n  diagnosis = {\n    category: 'UNKNOWN',\n    explanation: 'The AI diagnosis could not be parsed. Raw error: ' + prev.errorMessage,\n    retryable: false,\n    severity: 'MEDIUM',\n    fix_steps: ['Open the failed execution in n8n and review the error manually.']\n  };\n}\n\nconst steps = Array.isArray(diagnosis.fix_steps) ? diagnosis.fix_steps : [];\nconst fixStepsText = steps.map((s, i) => `${i + 1}. ${s}`).join('\\n');\n\nreturn [{\n  json: {\n    ...prev,\n    category: diagnosis.category || 'UNKNOWN',\n    explanation: diagnosis.explanation || 'No explanation returned.',\n    retryable: diagnosis.retryable === true,\n    severity: diagnosis.severity || 'MEDIUM',\n    fixStepsText: fixStepsText || 'Review the execution manually.'\n  }\n}];"
      },
      "id": "77706ccf-1a9b-4115-9abe-7744067dc4f1",
      "name": "Parse AI Diagnosis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2016, 1008]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=\ud83d\udee0\ufe0f *Workflow Issue Detected*\n\n*Workflow:* {{ $json.workflowName }}\n*Failed step:* {{ $json.failedNode }}\n*Severity:* {{ $json.severity }}\n*Category:* {{ $json.category }}\n\n*What happened:*\n{{ $json.explanation }}\n\n*How to fix it:*\n{{ $json.fixStepsText }}\n\n{{ $json.retryable ? '\ud83d\udca1 This looks like a temporary glitch \u2014 try simply re-running the execution first.' : '\u26a0\ufe0f This needs the fix above before it will work again.' }}\n\n\ud83d\udd17 Execution: {{ $json.executionUrl }}",
        "additionalFields": { "parse_mode": "Markdown" }
